# Lenny Growth Assistant Configuration

# Application Mode & Server
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM Configuration
# Active provider: 'local' (Ollama) or 'cloud' (OpenAI / Anthropic)
DEFAULT_LLM_PROVIDER=local

# Ollama (Local LLM & Embedding) Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud LLM Configuration (OpenAI / Anthropic)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database Configuration (SQLite default for simple local setup, PostgreSQL supported)
DATABASE_URL=sqlite:///./lenny_assistant.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_db

# Security & CORS
ALLOWED_ORIGINS=*
