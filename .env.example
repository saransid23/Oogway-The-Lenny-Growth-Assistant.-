# Lenny Growth Assistant Configuration

# Application Mode & Server
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# LLM Configuration
# Active provider: 'local' (Ollama) or 'cloud' (OpenAI / Anthropic)
DEFAULT_LLM_PROVIDER=local

# Ollama (Local LLM & Embedding) Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cloud LLM Configuration (OpenAI / Anthropic)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database Configuration (PostgreSQL supported via Supabase, Railway, or Docker Compose)
# 1. Docker Compose / Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/lenny_growth_db

# 2. Supabase Example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 3. Railway Example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@roundhouse.proxy.rlwy.net:[PORT]/railway

# 4. SQLite Fallback (Zero-install local development):
# DATABASE_URL=sqlite:///./lenny_assistant.db

# Security & CORS
ALLOWED_ORIGINS=*
